generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id     Int     @id @unique @default(autoincrement())
  name   String
  address String?
  phone String?
  email String @unique
  taxId String?
  password String
  orders Order[]
  salespersonId Int
  salesperson   SalesPerson @relation(fields: [salespersonId], references: [id])
  userType UserType
}

enum UserType {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  CUSTOMER
}

model Order {
  id          Int          @id @unique @default(autoincrement())
  userId  Int 
  user    User     @relation(fields: [userId], references: [id])
  salespersonId Int
  salesperson   SalesPerson @relation(fields: [salespersonId], references: [id])
  status      Int
  orderDate   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  orderNumber String
  shippingType String?
  shippingPort String?
  PaymentTerms String?
  items OrderItem[]
  comments String?
  shipmentTotalContainers Int?
  totalBoxes Int?
  netWeight Float?
  grossWeight Float?
  discount Float?
  total Float?
  totalMeters Float?

}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId Int
  order   Order @relation(fields: [orderId], references: [id])
  description String
  weight     Float?
  height     Float?
  quantity     Float?
  meters     Float?
  price     Float?
  total     Float?
}

model SalesPerson {
  id        Int     @id @default(autoincrement())
  name      String
  email     String
  phone     String
  users      User[]
  orders Order[]
}